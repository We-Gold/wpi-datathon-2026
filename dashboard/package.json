		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/d3": "^7.4.3",
		"@types/node": "^24.13.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	}
}
